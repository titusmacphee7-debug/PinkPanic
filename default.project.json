{
  "name": "PinkPanic",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$properties": {
        "CameraMode": "LockFirstPerson"
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Players": {
      "$properties": {
        "RespawnTime": 3
      }
    },
    "Lighting": {
      "$properties": {
        "Brightness": 2.5,
        "ClockTime": 14.5,
        "Ambient": [0.55, 0.47, 0.52],
        "OutdoorAmbient": [0.62, 0.52, 0.58]
      }
    }
  }
}
